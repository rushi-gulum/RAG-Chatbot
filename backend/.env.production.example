# ─────────────────────────────────────────────────────────────────────────────
# Backend production environment variables
# Copy this file to .env and fill in the real values.
# Never commit .env to source control.
# On Render: paste each variable into the Environment tab as a secret.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=production

# ── Auth ──────────────────────────────────────────────────────────────────────
# MUST be "false" in production. "true" is only for local development.
AUTH_DISABLED=false

# Firebase Admin SDK service-account — paste the entire JSON on one line.
# Obtain from Firebase Console → Project Settings → Service accounts → Generate new private key.
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"...","universe_domain":"googleapis.com"}

FIREBASE_PROJECT_ID=your-firebase-project-id

# ── Database (Supabase or Neon PostgreSQL) ────────────────────────────────────
# Supabase:  postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
# Neon:      postgresql://[user]:[password]@[host].neon.tech/[dbname]?sslmode=require
# Note: do NOT include channel_binding=require — psycopg2 does not support it.
#       The backend strips it automatically, but omitting it is cleaner.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# ── Groq LLM ──────────────────────────────────────────────────────────────────
# Obtain from https://console.groq.com/keys
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-20b

# ── Cloudflare Workers AI (embeddings) ────────────────────────────────────────
# Account ID: Cloudflare dashboard → right sidebar
# API Token: Cloudflare dashboard → My Profile → API Tokens → Create Token
#   (use "Workers AI" template or Workers:Read + AI:Run permissions)
EMBEDDING_PROVIDER=cloudflare
EMBEDDING_MODEL=@cf/baai/bge-small-en-v1.5
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=60

# ── Qdrant Cloud (vector store) ───────────────────────────────────────────────
# Obtain from https://cloud.qdrant.io → Cluster → API Key
QDRANT_URL=https://your-cluster-id.region.aws.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=rag_documents

# ── CORS ─────────────────────────────────────────────────────────────────────
# Set both to your Vercel frontend URL (no trailing slash).
FRONTEND_URL=https://your-app.vercel.app
ALLOWED_ORIGINS=https://your-app.vercel.app

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-64-char-hex-string
